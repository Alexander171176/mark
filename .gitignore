# ==========================================
# Laravel / PulsarCMS
# ==========================================

/vendor
/node_modules

# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Laravel Storage
# ==========================================

/storage/*.key
/storage/debugbar/
/storage/logs/*
!/storage/logs/.gitignore

/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

/storage/app/public/*
!/storage/app/public/.gitignore

/public/storage

# ==========================================
# Laravel Cache
# ==========================================

/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# ==========================================
# Database
# ==========================================

/database/analytics.sqlite
/database/analytics.sqlite-*
/database/*.sqlite-journal

# ==========================================
# Docker
# ==========================================

/storage/docker/_mysql/
/storage/docker/_redis/
/storage/docker/logs/

docker-compose.override.yml
docker/tmp/

# ==========================================
# Vite
# ==========================================

/public/hot
/public/build/

# ==========================================
# IDE
# ==========================================

/.idea/
/.vscode/
/.fleet/

# ==========================================
# Logs / Tests
# ==========================================

npm-debug.log*
yarn-error.log*

.phpunit.result.cache
/.phpunit.cache

# ==========================================
# Swagger
# ==========================================

/storage/api-docs/*

# ==========================================
# Local files
# ==========================================

Homestead.yaml
Homestead.json
